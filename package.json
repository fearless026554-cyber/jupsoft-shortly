{
  "name": "jupsoft-shortly-root",
  "version": "1.0.0",
  "private": true,
  "description": "Jupsoft Link Management Platform (JLMP)",
  "author": "Viraj (@virajverse)",
  "organization": "Jupsoft Technologies (jupsoft-system)",
  "scripts": {
    "dev": "pnpm --filter backend-nestjs start:dev",
    "dev:backend": "pnpm --filter backend-nestjs start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter backend-nestjs build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend-nestjs build",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --filter backend-nestjs start:prod",
    "start:backend": "pnpm --filter backend-nestjs start:prod",
    "start:frontend": "pnpm --filter frontend start",
    "test": "pnpm --filter backend-nestjs test",
    "typecheck": "pnpm --filter backend-nestjs build && pnpm --filter frontend typecheck",
    "lint": "pnpm --filter backend-nestjs lint",
    "deploy": "bash deploy/deploy-pm2.sh",
    "deploy:pm2": "bash deploy/deploy-pm2.sh",
    "deploy:docker": "bash deploy/deploy.sh"
  }
}
