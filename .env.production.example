# ==============================================================================
# Jupsoft Shortly (JLMP) - Production Environment Variables Template
# Copy this file to .env before deploying to VPS / Docker Compose
# ==============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration (Go.jupsoft.com)
# Hosted on Supabase (ap-northeast-1), completely separate from VPS disk.
# ------------------------------------------------------------------------------
PG_HOST=aws-0-ap-northeast-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=shortly_app.iqkqczxbtqoxcnmadegn
PG_PASSWORD=Jupsoft_Shortly_2026_App_Role!
PG_SSL=true
PG_POOL_MAX=25
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Redis Cache & Queue Configuration
# In production, REDIS_PASSWORD is required.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_StrongRedisSecretPass32!

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Networking
# JWT_SECRET must be at least 32 characters long.
# CORS_ORIGINS must be a strict comma-separated list of domains (wildcard * is forbidden).
# BASE_URL cannot point to localhost in production.
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_production_jwt_signing_key_min_32_chars!
JWT_EXPIRY=1d
TRUST_PROXY=true

# Public canonical root URL of Shortly
BASE_URL=https://go.jupsoft.com
FRONTEND_URL=https://go.jupsoft.com
CORS_ORIGINS=https://go.jupsoft.com,https://jupsoft.com

# Default Primary Shortening Domain
DEFAULT_DOMAIN_ID=0bb05033-f0ae-4779-b747-d386b8d67be1
DEFAULT_DOMAIN_HOST=go.jupsoft.com

# Initial Super Admin Provisioning (Sachin Sharma)
ADMIN_EMAIL=sachin@jupsoft.com
ADMIN_PASSWORD=ChangeMe_AdminPassword2026!

# ------------------------------------------------------------------------------
# 4. Anti-Abuse & Screening Services
# Required by backend env.ts in production to prevent malware & phishing distribution.
# Obtain from Google Cloud Console -> APIs & Services -> Safe Browsing API.
# ------------------------------------------------------------------------------
SAFE_BROWSING_API_KEY=AIzaSy_REPLACE_WITH_YOUR_ACTUAL_GOOGLE_SAFE_BROWSING_KEY

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Optional / Recommended)
# Obtain from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. Next.js Frontend Configuration
# Build-time and runtime domain references
# ------------------------------------------------------------------------------
BACKEND_URL=http://backend:3000
CMS_API_KEY=
NEXT_PUBLIC_DEFAULT_SHORT_DOMAIN=go.jupsoft.com
NEXT_PUBLIC_CNAME_DOMAIN=go.jupsoft.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
